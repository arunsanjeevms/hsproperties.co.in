# HS Properties — Environment Configuration
# Copy this file to .env and fill in your values.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hsproperties
DB_USER=root
DB_PASS=

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/hsproperties.co.in

# Admin (initial admin credentials — change after first login)
ADMIN_EMAIL=admin@hsproperties.com
ADMIN_PASS=changeme123

# File Uploads
UPLOAD_MAX_SIZE=20971520
UPLOAD_DIR=uploads

# Mail (optional — for notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=desk@hsproperties.com
MAIL_FROM_NAME=HS Properties
